# Single-inode Apptainer image for the TESS/K2 bright-star photometry stack
# (mundey + tessbkgd + halophot + CUDA 12 JAX) on Swinburne Ngarrgu Tindebeek ("NT") / OzSTAR.
#
# Submit hpc/build_halo_sif.sbatch from a trevor login node (internet access):
#   mkdir -p "$SCRATCH/logs" && sbatch hpc/build_halo_sif.sbatch
Bootstrap: docker
From: python:3.12.7-bookworm

%arguments
  # Default to audited `dev` heads prior to tagging; for post-release builds override via:
  #   --build-arg mundey_ref=v2.0.0 --build-arg tessbkgd_ref=v2.0.0 --build-arg halophot_ref=v2.0.0
  mundey_ref=dev
  tessbkgd_ref=dev
  halophot_ref=dev

%post
  set -eu
  export UV_LINK_MODE=copy
  # No OS package installer: python:3.12.7-bookworm already ships git, ca-certificates,
  # and build tools, and OzSTAR/NT builds run in a root-mapped user namespace (no /etc/subuid),
  # where sandbox users and cross-UID chown fail.
  python -m pip install --no-cache-dir uv
  # Stage uv cache and temp files inside the scratch-backed rootfs rather than the host's
  # small shared /tmp, then delete /opt/.build before image finalization.
  mkdir -p /opt/.build/uv-cache /opt/.build/tmp
  export UV_CACHE_DIR=/opt/.build/uv-cache TMPDIR=/opt/.build/tmp UV_SYSTEM_PYTHON=1

  # jax[cuda12] pip wheels bundle their own CUDA 12 runtime libraries.
  uv pip install -U "jax[cuda12]"

  uv pip install \
    "equinox>=0.11.5" \
    "optimistix>=0.0.7" \
    "optax>=0.2.2" \
    "zodiax>=0.5.0" \
    "numpy>=1.26" \
    "scipy>=1.11" \
    "astropy>=6.0" \
    "lightkurve>=2.4" \
    "astroquery>=0.4.7" \
    "matplotlib>=3.8" \
    "fsspec>=2024.2" \
    "s3fs>=2024.2" \
    "pyarrow>=15.0" \
    "tqdm>=4.66" \
    "pytest>=8.0" \
    "git+https://github.com/hvidy/mundey.git@{{ mundey_ref }}" \
    "git+https://github.com/hvidy/tessbkgd.git@{{ tessbkgd_ref }}" \
    "git+https://github.com/hvidy/halophot.git@{{ halophot_ref }}"

  python -m pip freeze > /etc/halo-sif-freeze.txt
  python -m pip list 2>/dev/null | grep -i -E "^(jax|jaxlib|equinox|optimistix|optax|zodiax|astropy|lightkurve|mundey|tessbkgd|halophot|s3fs|pyarrow|pytest) " || true
  rm -rf /opt/.build

%environment
  export LC_ALL=C
  export LANG=C
  export PYTHONNOUSERSITE=1
  export MPLBACKEND=Agg
  export JAX_DEFAULT_MATMUL_PRECISION=highest

%labels
  mundey_ref {{ mundey_ref }}
  tessbkgd_ref {{ tessbkgd_ref }}
  halophot_ref {{ halophot_ref }}

%runscript
  exec "$@"

%help
  Python 3.12 with jax[cuda12], mundey, tessbkgd, and halophot for Swinburne NT / OzSTAR.
  apptainer exec --nv --bind /fred,/aphid/scratch-3month halo.sif halo ...
